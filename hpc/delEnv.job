#!/bin/bash

#SBATCH --job-name=delEnv.out        # Job name
#SBATCH --output=delEnv-%j.out      # Name of output file (%j expands to jobId)
#SBATCH --cpus-per-task=8        # Schedule one core
#SBATCH --time=24:00:00          # Run time (hh:mm:ss) - run for one hour max
#SBATCH --partition=cores_any    # cpu is enough for deleting the folder

cd ..

rm -rf .venv

echo "Running on $(hostname):"